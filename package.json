{
  "name": "pastevault",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4000",
    "dev:1200": "vite --host 127.0.0.1 --port 1200",
    "start": "vite --host 127.0.0.1 --port 4000",
    "start:1200": "vite --host 127.0.0.1 --port 1200",
    "build": "vite build",
    "lint": "eslint .",
    "store:check": "node ./tests/store-check.mjs",
    "visual:check": "node ./tests/visual-check.mjs",
    "functional:check": "node ./tests/functional-check.mjs",
    "interaction:check": "node ./tests/interaction-check.mjs",
    "sync:check": "node ./tests/sync-check.mjs",
    "pair:check": "node ./tests/pair-check.mjs",
    "qr:check": "node ./tests/qr-check.mjs",
    "files:check": "node ./tests/files-check.mjs && node ./tests/text-preview-check.mjs",
    "files:flow": "node ./tests/files-flow-check.mjs",
    "offline:check": "node ./tests/offline-check.mjs",
    "files:viewer": "node ./tests/files-viewer-check.mjs",
    "mobile:check": "node ./tests/mobile-check.mjs",
    "api:check": "node ./tests/api-check.mjs",
    "share:check": "node ./tests/share-check.mjs",
    "share:flow": "node ./tests/share-flow-check.mjs",
    "test": "node ./tests/smoke-check.mjs",
    "verify": "npm run lint && npm run build && npm test && npm run store:check && npm run api:check && npm run share:check && npm run qr:check && npm run files:check"
  },
  "dependencies": {
